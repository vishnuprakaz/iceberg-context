{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AI extraction of one meeting (data/extract/meetings/<group>/<date>.json)",
  "type": "object",
  "required": ["id", "sources", "summary", "topics"],
  "additionalProperties": false,
  "properties": {
    "id": {"type": "string", "pattern": "^meeting/[a-z0-9-]+/\\d{4}-\\d{2}-\\d{2}$"},
    "sources": {"type": "array", "minItems": 1, "items": {"type": "string", "pattern": "^(meet|yt):"}},
    "summary": {"type": "string", "minLength": 40, "maxLength": 1200},
    "topics": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object",
        "required": ["title", "summary"],
        "additionalProperties": false,
        "properties": {
          "title": {"type": "string"},
          "summary": {"type": "string", "minLength": 20},
          "initiatives": {"type": "array", "items": {"type": "string", "pattern": "^[a-z0-9-]+$"}},
          "refs": {"type": "array", "items": {"type": "string", "pattern": "^(gh|doc|list|devlist|yt|spec):"}},
          "decisions": {"type": "array", "items": {"type": "string"}},
          "open_questions": {"type": "array", "items": {"type": "string"}},
          "quotes": {"type": "array", "items": {"type": "object", "required": ["text", "at"], "additionalProperties": false,
            "properties": {"text": {"type": "string", "maxLength": 400}, "at": {"type": "string", "pattern": "^\\d+:\\d{2}:\\d{2}$"},
                           "speaker": {"type": "string"}}}}
        }
      }
    },
    "action_items": {"type": "array", "items": {"type": "object", "required": ["what"], "additionalProperties": false,
      "properties": {"who": {"type": "string"}, "what": {"type": "string"}}}},
    "participants": {"type": "array", "items": {"type": "object", "required": ["who", "basis"], "additionalProperties": false,
      "properties": {"who": {"type": "string"}, "basis": {"enum": ["notes", "transcript"]}}}}
  }
}
