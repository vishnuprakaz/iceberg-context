{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AI extraction of one dev-list thread (data/extract/threads/<thread>.json)",
  "type": "object",
  "required": ["id", "sources", "title", "summary", "outcome"],
  "additionalProperties": false,
  "properties": {
    "id": {"type": "string", "pattern": "^thread/t-[0-9a-f]{16}$"},
    "sources": {"type": "array", "minItems": 1, "items": {"type": "string", "pattern": "^devlist:"}},
    "title": {"type": "string"},
    "summary": {"type": "string", "minLength": 40, "maxLength": 1500},
    "positions": {"type": "array", "items": {"type": "object", "required": ["who", "stance", "source"], "additionalProperties": false,
      "properties": {"who": {"type": "string"}, "stance": {"type": "string"}, "source": {"type": "string", "pattern": "^devlist:"}}}},
    "outcome": {"type": "object", "required": ["status"], "additionalProperties": false,
      "properties": {"status": {"enum": ["open", "passed", "failed", "withdrawn", "consensus", "no-conclusion", "informational"]},
                     "note": {"type": "string"}, "source": {"type": "string", "pattern": "^devlist:"}}},
    "initiatives": {"type": "array", "items": {"type": "string", "pattern": "^[a-z0-9-]+$"}},
    "refs": {"type": "array", "items": {"type": "string", "pattern": "^(gh|doc|list|devlist|yt|spec):"}},
    "why_it_matters": {"type": "string"}
  }
}
