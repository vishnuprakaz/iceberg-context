{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Knowledge-base page frontmatter",
  "type": "object",
  "required": ["id", "type", "title"],
  "properties": {
    "id": {"type": "string", "pattern": "^(person|group|initiative|module|repo|release|meeting|thread)/[A-Za-z0-9._/-]+$"},
    "type": {"enum": ["person", "group", "initiative", "module", "repo", "release", "meeting", "thread"]},
    "title": {"type": "string", "minLength": 1},
    "updated": {"type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$"},
    "status": {"type": "string"},
    "sources": {"type": "array", "items": {"type": "string"}},
    "links": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["rel", "to"],
        "properties": {
          "rel": {"type": "string", "pattern": "^[a-z_]+$"},
          "to": {"type": "string"},
          "confidence": {"enum": ["observed", "extracted", "inferred"]},
          "source": {"type": "string"},
          "since": {"type": "string"},
          "until": {"type": "string"},
          "n": {"type": "integer"},
          "window": {"type": "string"},
          "note": {"type": "string"}
        },
        "additionalProperties": false,
        "if": {"properties": {"confidence": {"enum": ["extracted", "inferred"]}}, "required": ["confidence"]},
        "then": {"required": ["source"]}
      }
    }
  },
  "allOf": [
    {"if": {"properties": {"type": {"const": "person"}}}, "then": {"required": ["login"], "not": {"anyOf": [
      {"required": ["email"]}, {"required": ["phone"]}, {"required": ["address"]}, {"required": ["location"]}, {"required": ["age"]}, {"required": ["family"]}]}}},
    {"if": {"properties": {"type": {"const": "initiative"}}}, "then": {"required": ["status"]}},
    {"if": {"properties": {"type": {"const": "module"}}}, "then": {"required": ["repo", "path"]}},
    {"if": {"properties": {"type": {"const": "release"}}}, "then": {"required": ["repo", "version"]}},
    {"if": {"properties": {"type": {"const": "meeting"}}}, "then": {"required": ["date", "group"]}},
    {"if": {"properties": {"type": {"const": "thread"}}}, "then": {"required": ["date", "url"]}}
  ]
}
