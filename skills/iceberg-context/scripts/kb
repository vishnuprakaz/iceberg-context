#!/usr/bin/env python3
"""kb: query the Iceberg Context knowledge base.

Standard library only. Reads kb/ and data/ from the Iceberg Context repository and keeps a search index in a
cache directory. When the skill is installed without the repository, it downloads a copy on first use.
"""
from __future__ import annotations

import argparse
import datetime as dt
import hashlib
import json
import os
import re
import sqlite3
import subprocess
import sys
from pathlib import Path

KB = "kb"
PAGE_DIRS = tuple(f"{KB}/{d}" for d in ("people", "groups", "initiatives", "modules", "repos", "releases", "records"))
DOC_DIRS = ("docs", "notes", f"{KB}/briefings", f"{KB}/maps")
DOC_FILES = (f"{KB}/state-of-iceberg.md", f"{KB}/opportunities.md")
SOURCES = ("devlist", "github", "git", "spec", "asf", "syncdocs", "calendar", "youtube")
FRONTMATTER = re.compile(r"\A---\n.*?\n---\n?", re.S)
SCHEMA_VERSION = "4"


REPO_URL = os.environ.get("ICEBERG_CONTEXT_REPO", "https://github.com/vishnuprakaz/iceberg-context")
REFRESH_HOURS = 12


def cache_dir() -> Path:
    base = os.environ.get("XDG_CACHE_HOME") or str(Path.home() / ".cache")
    d = Path(base) / "iceberg-context"
    d.mkdir(parents=True, exist_ok=True)
    return d


def offline() -> bool:
    return os.environ.get("ICEBERG_CONTEXT_OFFLINE", "") not in ("", "0")


def refresh(repo: Path) -> bool:
    """Bring the downloaded copy of the knowledge base up to date. Returns False if the network or git failed."""
    try:
        fetch = subprocess.run(["git", "-C", str(repo), "fetch", "--quiet", "--depth", "1", "origin", "main"],
                               capture_output=True, text=True, timeout=180)
        if fetch.returncode != 0:
            return False
        subprocess.run(["git", "-C", str(repo), "reset", "--quiet", "--hard", "FETCH_HEAD"], capture_output=True, timeout=120)
        (repo.parent / "last-refresh").write_text(dt.datetime.now(dt.timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ"))
        return True
    except (subprocess.TimeoutExpired, FileNotFoundError):
        return False


def downloaded_copy() -> Path:
    """The knowledge base is data in the skill's repository. When the skill is installed on its own
    (for example with `npx skills add`), keep a shallow clone in the cache and refresh it now and then."""
    repo = cache_dir() / "repo"
    if not (repo / "schema" / "page.json").exists():
        if offline():
            sys.exit("kb: no knowledge base found and ICEBERG_CONTEXT_OFFLINE is set. Clone the repository and set ICEBERG_CONTEXT_ROOT.")
        print(f"kb: downloading the knowledge base from {REPO_URL} (first use only)…", file=sys.stderr)
        try:
            res = subprocess.run(["git", "clone", "--quiet", "--depth", "1", REPO_URL, str(repo)], capture_output=True, text=True, timeout=900)
        except (subprocess.TimeoutExpired, FileNotFoundError) as exc:
            sys.exit(f"kb: could not download the knowledge base ({exc}). Clone {REPO_URL} yourself and set ICEBERG_CONTEXT_ROOT to it.")
        if res.returncode != 0:
            sys.exit(f"kb: could not download the knowledge base: {res.stderr.strip()[-300:]}\n"
                     f"Clone {REPO_URL} yourself and set ICEBERG_CONTEXT_ROOT to it.")
        (repo.parent / "last-refresh").write_text(dt.datetime.now(dt.timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ"))
    elif not offline():
        stamp = repo.parent / "last-refresh"
        age_h = (dt.datetime.now().timestamp() - stamp.stat().st_mtime) / 3600 if stamp.exists() else 1e9
        if age_h > REFRESH_HOURS:
            refresh(repo)  # best effort: an old copy is still usable
    return repo


def repo_root() -> Path:
    env = os.environ.get("ICEBERG_CONTEXT_ROOT")
    if env:
        return Path(env).resolve()
    here = Path(__file__).resolve()
    for parent in here.parents:
        if (parent / "schema" / "page.json").exists():
            return parent
    return downloaded_copy()


def read_jsonl(path: Path):
    if not path.exists():
        return
    with path.open(encoding="utf-8") as fh:
        for line in fh:
            line = line.strip()
            if line:
                yield json.loads(line)


# ---------------------------------------------------------------- index

def indexed_files(root: Path) -> list[Path]:
    files: list[Path] = []
    for d in PAGE_DIRS + DOC_DIRS:
        if (root / d).is_dir():
            files += (root / d).rglob("*.md")
    files += [root / f for f in DOC_FILES if (root / f).exists()]
    for d in (f"{KB}/index", "data/raw", "data/links"):
        if (root / d).is_dir():
            files += (root / d).rglob("*.jsonl")
    return sorted(files)


def fingerprint(root: Path, files: list[Path]) -> str:
    h = hashlib.sha1(SCHEMA_VERSION.encode())
    for f in files:
        st = f.stat()
        h.update(f"{f.relative_to(root)}|{st.st_size}|{st.st_mtime_ns}\n".encode())
    return h.hexdigest()[:16]


def connect(path: Path) -> sqlite3.Connection:
    con = sqlite3.connect(path)
    con.row_factory = sqlite3.Row
    return con


def open_db(root: Path) -> sqlite3.Connection:
    files = indexed_files(root)
    db_path = cache_dir() / f"kb-{fingerprint(root, files)}.sqlite"
    if db_path.exists():
        return connect(db_path)
    for old in cache_dir().glob("kb-*"):
        old.unlink(missing_ok=True)
    tmp = db_path.with_suffix(".tmp")
    if sum(f.stat().st_size for f in files) > 20_000_000:
        print("kb: building the search index (first run after an update; takes a moment)…", file=sys.stderr)
    con = sqlite3.connect(tmp)
    con.executescript(
        """
        pragma journal_mode = off; pragma synchronous = off;
        create table nodes(id text primary key, type text, title text, status text, updated text, path text, meta text);
        create table edges(src text, rel text, dst text, confidence text, source text, since text, meta text);
        create table raw(id text primary key, source text, type text, date text, url text, title text,
                         people text, file text, meta text);
        create table refs(src text, dst text);
        create table people(person text, id text, type text, date text);
        create table files(path text, id text, repo text, date text, kind text);
        create virtual table fts using fts5(id unindexed, kind unindexed, date unindexed, title, body,
                                            tokenize='porter unicode61');
        """
    )
    for n in read_jsonl(root / KB / "index" / "nodes.jsonl"):
        con.execute("insert or replace into nodes values(?,?,?,?,?,?,?)",
                    (n["id"], n.get("type"), n.get("title"), n.get("status"), str(n.get("updated") or ""),
                     n.get("path"), json.dumps(n, ensure_ascii=False)))
    for e in read_jsonl(root / KB / "index" / "edges.jsonl"):
        con.execute("insert into edges values(?,?,?,?,?,?,?)",
                    (e["src"], e["rel"], e["to"], e.get("confidence"), e.get("source"), e.get("since"),
                     json.dumps(e, ensure_ascii=False)))
    for e in read_jsonl(root / "data" / "links" / "edges.jsonl"):
        con.execute("insert into refs values(?,?)", (e["src"], e["dst"]))
    node_by_path = {r[0]: r[1] for r in con.execute("select path, id from nodes")}
    for f in files:
        rel = f.relative_to(root).as_posix()
        if f.suffix == ".md":
            text = FRONTMATTER.sub("", f.read_text(encoding="utf-8", errors="replace"))
            first = next((ln.lstrip("# ").strip() for ln in text.splitlines() if ln.startswith("#")), rel)
            pid = node_by_path.get(rel, f"file:{rel}")
            kind = pid.split("/")[0] if rel in node_by_path else "doc"
            con.execute("insert into fts values(?,?,?,?,?)", (pid, kind, "", first, text))
        elif rel.startswith("data/raw/"):
            for r in read_jsonl(f):
                meta = r.get("meta") or {}
                rid, date = r["id"], r.get("date") or ""
                con.execute("insert or replace into raw values(?,?,?,?,?,?,?,?,?)",
                            (rid, r.get("source"), r.get("type"), date, r.get("url"), r.get("title"),
                             json.dumps(r.get("people") or []), rel, json.dumps(meta, ensure_ascii=False)))
                con.executemany("insert into refs values(?,?)", [(rid, d) for d in r.get("refs") or []])
                con.executemany("insert into people values(?,?,?,?)",
                                [(p, rid, r.get("type"), date) for p in r.get("people") or []])
                for person in {v.get("by") for v in meta.get("reviews") or [] if v.get("by")}:
                    con.execute("insert into people values(?,?,?,?)", (person, rid, "reviewed", date))
                if meta.get("files"):
                    kind = r.get("type")
                    con.executemany("insert into files values(?,?,?,?,?)",
                                    [(p, rid, meta.get("repo"), date, kind) for p in meta["files"]])
                if r.get("type") != "commit":
                    con.execute("insert into fts values(?,?,?,?,?)",
                                (rid, r.get("type") or "raw", date, r.get("title") or "", r.get("body") or ""))
    con.executescript(
        """
        create index edges_src on edges(src); create index edges_dst on edges(dst);
        create index refs_dst on refs(dst); create index refs_src on refs(src);
        create index people_p on people(person, date); create index files_p on files(path, date);
        create index raw_date on raw(type, date);
        """
    )
    con.commit()
    con.close()
    tmp.replace(db_path)
    return connect(db_path)


# ---------------------------------------------------------------- helpers

def today() -> dt.date:
    return dt.datetime.now(dt.timezone.utc).date()


def since_date(value: str | None, default_days: int) -> str:
    """Accept YYYY-MM-DD or a span such as 7d, 6w, 3m, 1y."""
    if value and re.fullmatch(r"\d{4}-\d{2}-\d{2}", value):
        return value
    m = re.fullmatch(r"(\d+)([dwmy])", value or "")
    days = int(m.group(1)) * {"d": 1, "w": 7, "m": 30, "y": 365}[m.group(2)] if m else default_days
    return (today() - dt.timedelta(days=days)).isoformat()


def age(ts: str | None) -> str:
    if not ts:
        return "never"
    try:
        then = dt.datetime.strptime(ts, "%Y-%m-%dT%H:%M:%SZ").replace(tzinfo=dt.timezone.utc)
    except ValueError:
        return ts
    hours = (dt.datetime.now(dt.timezone.utc) - then).total_seconds() / 3600
    return f"{hours:.0f}h ago" if hours < 48 else f"{hours / 24:.0f}d ago"


def who(p: str) -> str:
    return p[5:] if p.startswith("name:") else ("@" + p if not p.startswith("asf:") else p)


def people_of(row) -> str:
    return ", ".join(who(p) for p in json.loads(row["people"] or "[]"))


def excerpt(text: str, grep: str | None, chars: int) -> str:
    if grep:
        hits = [m.start() for m in re.finditer(re.escape(grep), text, re.I)]
        if not hits:
            return f"(no match for {grep!r} in this source)"
        half = max(200, chars // (2 * min(len(hits), 3)))
        parts = [text[max(0, h - half): h + half].strip() for h in hits[:3]]
        return "\n…\n".join(parts) + (f"\n\n({len(hits)} matches)" if len(hits) > 3 else "")
    return text if len(text) <= chars else text[:chars].rstrip() + f"\n… ({len(text) - chars} more characters; use --chars or --grep)"


def load_record(root: Path, row) -> dict:
    return next(r for r in read_jsonl(root / row["file"]) if r["id"] == row["id"])


def match_paths(con, path: str) -> tuple[str, list]:
    """Resolve a user path to a SQL condition: exact file, path suffix, or directory prefix."""
    path = path.strip().lstrip("./")
    if con.execute("select 1 from files where path = ? limit 1", (path,)).fetchone():
        return "path = ?", [path]
    if con.execute("select 1 from files where path like ? limit 1", (path.rstrip("/") + "/%",)).fetchone():
        return "path like ?", [path.rstrip("/") + "/%"]
    return "path like ?", ["%" + path]


def find_node(con, text: str, kind: str | None = None):
    cond, params = ("and type = ?", [kind]) if kind else ("", [])
    for sql, arg in (("id = ?", text), ("id = ?", f"{kind}/{text}" if kind else text), ("id like ?", f"%/{text}"),
                     ("lower(title) = lower(?)", text), ("id like ?", f"%{text}%"), ("title like ?", f"%{text}%")):
        row = con.execute(f"select * from nodes where {sql} {cond} order by length(id) limit 1", [arg] + params).fetchone()
        if row:
            return row
    return None


def mentions(con, target: str, limit: int = 6) -> list:
    return con.execute(
        "select r.* from refs f join raw r on r.id = f.src where f.dst = ? and r.type != 'commit' "
        "group by r.id order by r.date desc limit ?", (target, limit)).fetchall()


def print_mentions(con, target: str, indent: str = "    ", limit: int = 6) -> None:
    for m in mentions(con, target, limit):
        print(f"{indent}↳ {m['type']} {m['date'][:10]}  {m['title'][:90]}  [{m['id']}]")


# ---------------------------------------------------------------- commands

def cmd_update(root: Path, args) -> int:
    if root == cache_dir() / "repo":
        ok = refresh(root)
    else:
        res = subprocess.run(["git", "-C", str(root), "pull", "--ff-only", "--quiet"], capture_output=True, text=True)
        ok = res.returncode == 0
        if not ok:
            print(res.stderr.strip()[-300:], file=sys.stderr)
    print("knowledge base updated" if ok else "kb: update failed; still using the existing copy")
    return 0 if ok else 1


def cmd_status(root: Path, args) -> int:
    con = open_db(root)
    print("Iceberg Context status\n")
    where = "downloaded copy, refreshed automatically" if root == cache_dir() / "repo" else "repository checkout; `kb update` or `git pull` to refresh"
    print(f"knowledge base: {root} ({where})\n")
    print(f"{'source':<10} {'status':<8} {'last success':<13} detail")
    for s in SOURCES:
        p = root / "data" / "state" / f"{s}.json"
        st = json.loads(p.read_text()) if p.exists() else {"status": "never"}
        counts = ", ".join(f"{k}={v}" for k, v in sorted((st.get("counts") or {}).items()))
        print(f"{s:<10} {st.get('status', 'never'):<8} {age(st.get('last_success')):<13} {st.get('error') or counts}")
    print("\nKnowledge base:")
    rows = con.execute("select type, count(*) c from nodes group by type order by type").fetchall()
    print("  pages:   " + (", ".join(f"{r['type']}={r['c']}" for r in rows) or "none yet"))
    print(f"  links:   {con.execute('select count(*) from edges').fetchone()[0]}")
    rows = con.execute("select type, count(*) c, max(date) d from raw group by type order by type").fetchall()
    print("  records: " + (", ".join(f"{r['type']}={r['c']} (to {str(r['d'])[:10]})" for r in rows) or "none yet"))
    briefs = sorted((root / KB / "briefings" / "weekly").glob("*.md"))
    print(f"  latest briefing: {briefs[-1].relative_to(root) if briefs else 'none yet'}")
    return 0


def fts_terms(q: str) -> list[str]:
    """Split user text into safely quoted FTS5 terms: quoted phrases stay phrases, every other word is quoted."""
    out = []
    for phrase, word in re.findall(r'"([^"]+)"|(\S+)', q):
        term = (phrase or word).replace('"', " ").strip()
        if term:
            out.append('"' + term + '"')
    return out


def search_rows(con, query: str, kind: str | None, since: str | None, limit: int):
    terms = fts_terms(query)
    if not terms:
        return [], "all"
    cond = ("and kind = ? " if kind else "") + ("and (date = '' or date >= ?) " if since else "")
    sql = ("select id, kind, date, title, snippet(fts, 4, '[', ']', ' … ', 24) snip from fts "
           f"where fts match ? {cond} order by bm25(fts, 0, 0, 0, 5.0, 1.0) limit ?")
    rows, mode = [], "all"
    # First require every term; if nothing matches, fall back to any term, best matches first.
    for mode, joiner in (("all", " "), ("any", " OR ")):
        params = [joiner.join(terms)] + ([kind] if kind else []) + ([since] if since else []) + [limit]
        rows = con.execute(sql, params).fetchall()
        if rows or len(terms) == 1:
            break
    return rows, mode


def cmd_search(root: Path, args) -> int:
    con = open_db(root)
    since = since_date(args.since, 0) if args.since else None
    rows, mode = search_rows(con, " ".join(args.query), args.type, since, args.limit)
    if not rows:
        print("no results")
        return 0
    if mode == "any":
        print("(nothing matched every word; showing matches for any of them)\n")
    for r in rows:
        date = f" {r['date'][:10]}" if r["date"] else ""
        print(f"{r['id']}  [{r['kind']}{date}]\n  {r['title']}\n  {' '.join(r['snip'].split())}\n")
    print(f"{len(rows)} result(s). Show one with: kb source <id>")
    return 0


def cmd_source(root: Path, args) -> int:
    con = open_db(root)
    ident = args.id
    row = con.execute("select * from raw where id = ?", (ident,)).fetchone()
    if row:
        rec = load_record(root, row)
        meta = rec.get("meta") or {}
        print(f"id:     {rec['id']}\ntype:   {rec.get('type')} ({rec.get('source')})\ndate:   {rec.get('date')}")
        print(f"title:  {rec.get('title', '')}\npeople: {people_of(row)}\nurl:    {rec.get('url')}")
        for key in ("state", "merged_at", "merged_by", "closed_at", "updated_at", "labels", "milestone", "group", "status", "kind", "video", "confidence"):
            if meta.get(key):
                value = meta[key]
                print(f"{key + ':':<8}{', '.join(value) if isinstance(value, list) else value}")
        if meta.get("reviews"):
            print("reviews: " + ", ".join(f"@{v['by']} {v['state'].lower()}" for v in meta["reviews"][:15]))
        if rec.get("ai_generated"):
            print("note:   this source text was itself AI-generated")
        if rec.get("refs"):
            print(f"refs:   {', '.join(rec['refs'][:20])}")
        if meta.get("files"):
            print(f"files:  {', '.join(meta['files'][:12])}" + (" …" if len(meta["files"]) > 12 else ""))
        print()
        print(excerpt(rec.get("body") or "", args.grep, args.chars))
        return 0
    node = con.execute("select * from nodes where id = ?", (ident,)).fetchone()
    path = root / node["path"] if node else (root / ident[5:] if ident.startswith("file:") else None)
    if path and path.exists():
        print(f"id:   {ident}\nfile: {path.relative_to(root)}\n")
        print(excerpt(path.read_text(encoding="utf-8"), args.grep, args.chars))
        return 0
    print(f"kb: no record or page with id {ident!r}. Try: kb search <words>", file=sys.stderr)
    return 1


def cmd_why(root: Path, args) -> int:
    con = open_db(root)
    cond, params = match_paths(con, args.path)
    commits = con.execute(
        f"select r.*, count(*) n from files f join raw r on r.id = f.id where f.kind = 'commit' and {cond} "
        "group by r.id order by r.date desc limit ?", params + [args.limit]).fetchall()
    if not commits:
        print(f"no history found for {args.path!r}. Paths are relative to the repository root, e.g. core/src/main/java/…")
        return 1
    total = con.execute(f"select count(distinct id), min(date), count(distinct path) from files where kind = 'commit' and {cond}",
                        params).fetchone()
    print(f"History of {args.path}: {total[0]} commits since {total[1][:10]}"
          + (f" across {total[2]} files" if total[2] > 1 else "") + f". Newest {len(commits)}:\n")
    for c in commits:
        meta = json.loads(c["meta"])
        target = f"gh:{meta['repo']}#{meta['pr']}" if meta.get("pr") else None
        print(f"{c['date'][:10]}  {c['title']}\n    by {people_of(c)}   {c['url']}")
        if target:
            pr = con.execute("select * from raw where id = ?", (target,)).fetchone()
            if pr:
                pm = json.loads(pr["meta"])
                revs = ", ".join(sorted({"@" + v["by"] for v in pm.get("reviews") or [] if v.get("by")}))
                print(f"    PR {target}: reviewed by {revs or 'n/a'}; merged by @{pm.get('merged_by') or 'n/a'}; "
                      f"{pm.get('comments', 0)} comments   (kb source {target})")
            else:
                print(f"    PR https://github.com/{meta['repo']}/pull/{meta['pr']}  (details not synced yet)")
            print_mentions(con, target)
        print()
    if args.symbol:
        checkout = Path(args.checkout or ".").resolve()
        res = subprocess.run(["git", "-C", str(checkout), "log", "--format=%ad %h %s", "--date=short", "-s",
                              f"-L:{args.symbol}:{args.path}"], capture_output=True, text=True)
        print(f"Commits touching `{args.symbol}` (from the checkout at {checkout}):")
        print(res.stdout.strip() or f"  (git log -L failed: {res.stderr.strip()[:200]}; pass --checkout <path to an Iceberg clone with history>)")
    print("Next: `kb source <id>` shows the discussion text for any id in brackets.")
    return 0


def cmd_context(root: Path, args) -> int:
    con = open_db(root)
    recent = since_date(args.since, 365)
    for path in args.paths:
        cond, params = match_paths(con, path)
        dir_cond, dir_params = ("path like ?", [path.rsplit("/", 1)[0] + "/%"]) if "/" in path else (cond, params)
        print(f"== {path}")
        repo = con.execute(f"select repo from files where {cond} limit 1", params).fetchone()
        if not repo:
            print("  no history found for this path\n")
            continue
        top = path.split("/")[0]
        module = find_node(con, f"module/{repo['repo'].split('/')[1]}/{top}")
        if module:
            print(f"  module page: {module['path']} ({module['title']})")
        rows = con.execute(
            f"select p.person, count(distinct f.id) n from files f join people p on p.id = f.id "
            f"where f.kind = 'commit' and f.date >= ? and {dir_cond} group by p.person order by n desc limit 6",
            [recent] + dir_params).fetchall()
        print(f"  active authors in this directory since {recent}: " + (", ".join(f"{who(r['person'])} ({r['n']})" for r in rows) or "none"))
        rows = con.execute(
            f"select p.person, count(distinct p.id) n from files f join people p on p.id = f.id "
            f"where f.kind = 'pr' and p.type = 'reviewed' and f.date >= ? and {dir_cond} "
            "group by p.person order by n desc limit 6", [recent] + dir_params).fetchall()
        print("  reviewers of pull requests here: " + (", ".join(f"{who(r['person'])} ({r['n']})" for r in rows)
                                                       or "not synced yet (see maps/reviewers.md)"))
        open_prs = con.execute(
            f"select distinct r.* from files f join raw r on r.id = f.id where f.kind = 'pr' and {cond} "
            "and json_extract(r.meta, '$.state') = 'open' order by r.date desc limit 8", params).fetchall()
        print(f"  open pull requests touching it: {len(open_prs) or 'none found'}")
        for r in open_prs:
            print(f"    {r['id']}  {r['title'][:90]}  ({people_of(r)}, {r['date'][:10]})")
        commits = con.execute(
            f"select distinct r.* from files f join raw r on r.id = f.id where f.kind = 'commit' and {cond} "
            "order by r.date desc limit 5", params).fetchall()
        print("  latest changes:")
        seen_init = {}
        for c in commits:
            meta = json.loads(c["meta"])
            print(f"    {c['date'][:10]}  {c['title'][:100]}")
            if meta.get("pr"):
                target = f"gh:{meta['repo']}#{meta['pr']}"
                print_mentions(con, target, indent="        ", limit=3)
                for e in con.execute("select n.id, n.title from edges e join nodes n on n.id = e.src where e.dst = ?", (target,)):
                    seen_init[e["id"]] = e["title"]
        if seen_init:
            print("  related pages: " + ", ".join(f"{t} [{i}]" for i, t in seen_init.items()))
        print()
    print("Also read AGENTS.md and CONTRIBUTING.md in the repository you are editing. `kb why <path>` gives the longer history.")
    return 0


def show_node(root: Path, con, node, chars: int) -> None:
    print(f"{node['title']}  [{node['id']}]" + (f"  status: {node['status']}" if node["status"] else "")
          + (f"  updated: {node['updated']}" if node["updated"] else ""))
    print(f"file: {node['path']}\n")
    text = FRONTMATTER.sub("", (root / node["path"]).read_text(encoding="utf-8"))
    text = re.sub(r"<!-- kb:generated:(start|end) -->\n?", "", text).strip()
    print(excerpt(text, None, chars))
    out = con.execute("select * from edges where src = ? order by rel, dst", (node["id"],)).fetchall()
    inc = con.execute("select * from edges where dst = ? order by rel, src", (node["id"],)).fetchall()
    if out or inc:
        print("\nLinks:")
    for e in out:
        note = f" ({e['confidence']})" if e["confidence"] and e["confidence"] != "observed" else ""
        print(f"  {e['rel']} → {e['dst']}{note}")
    for e in inc:
        print(f"  {e['src']} {e['rel']} → this")


def cmd_show(kind: str | None):
    def run(root: Path, args) -> int:
        con = open_db(root)
        node = find_node(con, " ".join(args.name), kind)
        if not node:
            label = kind or "page"
            print(f"kb: no {label} matches {' '.join(args.name)!r}.")
            rows = con.execute("select id, title from nodes where type = ? order by id limit 60", (kind,)).fetchall() if kind else []
            if rows:
                print(f"Known {label}s: " + ", ".join(r["id"].split("/", 1)[1] for r in rows))
            return 1
        show_node(root, con, node, args.chars)
        if kind == "person":
            login = node["id"].split("/", 1)[1]
            recent = since_date(None, 365)
            rows = con.execute("select type, count(distinct id) n from people where person = ? and date >= ? group by type",
                               (login, recent)).fetchall()
            if rows:
                print(f"\nActivity since {recent}: " + ", ".join(f"{r['type']}={r['n']}" for r in rows))
            rows = con.execute("select r.* from people p join raw r on r.id = p.id where p.person = ? and r.type = 'email' "
                               "and json_extract(r.meta, '$.reply') = 0 order by r.date desc limit 6", (login,)).fetchall()
            if rows:
                print("Recent threads started:")
                for r in rows:
                    print(f"  {r['date'][:10]}  {r['title'][:100]}  [{r['id']}]")
        return 0
    return run


def cmd_who(root: Path, args) -> int:
    con = open_db(root)
    topic = " ".join(args.topic)
    recent = since_date(args.since, 365)
    if "/" in topic or re.search(r"\.\w{1,5}$", topic):
        cond, params = match_paths(con, topic)
        if con.execute(f"select 1 from files where {cond} limit 1", params).fetchone():
            print(f"People active on {topic} since {recent}:\n")
            for label, kind, ptype in (("authors of merged changes", "commit", "commit"), ("reviewers", "pr", "reviewed")):
                rows = con.execute(
                    f"select p.person, count(distinct p.id) n, max(p.date) last from files f join people p on p.id = f.id "
                    f"where f.kind = ? and p.type = ? and f.date >= ? and {cond} group by p.person order by n desc limit 8",
                    [kind, ptype, recent] + params).fetchall()
                print(f"  {label}: " + (", ".join(f"{who(r['person'])} ({r['n']}, last {r['last'][:10]})" for r in rows)
                                         or "not synced yet"))
            top = topic.split("/")[0]
            module = con.execute("select * from nodes where type = 'module' and id like ?", (f"%/{top}",)).fetchone()
            if module:
                print(f"\n  module page: {module['path']}")
            return 0
    hits = []
    for kind in ("initiative", "group", "module"):
        rows, _ = search_rows(con, topic, kind, None, 3)
        hits += rows
    if not hits:
        print(f"no group, initiative or module matches {topic!r}. Try `kb search {topic}`.")
        return 1
    print(f"Where {topic!r} is handled:\n")
    for h in hits:
        node = con.execute("select * from nodes where id = ?", (h["id"],)).fetchone()
        meta = json.loads(node["meta"])
        print(f"{node['title']}  [{node['id']}]")
        for key in ("cadence", "status", "notes_doc"):
            if meta.get(key):
                print(f"  {key}: {meta[key]}")
        rels = con.execute("select * from edges where (src = ? or dst = ?) and (src like 'person/%' or dst like 'person/%')",
                           (node["id"], node["id"])).fetchall()
        for e in rels[:10]:
            other = e["dst"] if e["src"] == node["id"] else e["src"]
            note = f" ({e['confidence']})" if e["confidence"] and e["confidence"] != "observed" else ""
            print(f"  {e['rel']}: @{other.split('/', 1)[1]}{note}")
        print()
    return 0


def cmd_whats_new(root: Path, args) -> int:
    con = open_db(root)
    since = since_date(args.since, 7)
    area = f"%{args.area}%" if args.area else None
    print(f"What changed since {since}" + (f" (filter: {args.area})" if args.area else "") + "\n")

    def section(title, sql, params, fmt):
        rows = con.execute(sql, params).fetchall()
        if rows:
            print(f"{title} ({len(rows)}):")
            for r in rows:
                print("  " + fmt(r))
            print()

    def line(r):
        return f"{r['date'][:10]}  {r['title'][:100]}  [{r['id']}]"
    like = "and title like ?" if area else ""
    extra = [area] if area else []
    for kinds, title in ((("vote", "release-vote"), "Votes started"), (("result",), "Vote results"), (("announce",), "Announcements"),
                         (("discuss", "release-planning"), "Discussions started"), (("roster",), "Roster news")):
        marks = ",".join("?" * len(kinds))
        reply = "" if kinds == ("result",) else "and json_extract(meta, '$.reply') = 0"
        section(title, f"select * from raw where type = 'email' and date >= ? and json_extract(meta, '$.kind') in ({marks}) "
                       f"{reply} {like} group by json_extract(meta, '$.thread') order by date desc limit 25",
                [since, *kinds] + extra, line)
    section("Meetings with notes", f"select * from raw where type = 'meeting-notes' and date >= ? {like} order by date desc limit 25",
            [since] + extra, line)
    section("Recordings", f"select * from raw where type = 'transcript' and date >= ? {like} order by date desc limit 25",
            [since] + extra, line)
    section("Spec and API changes merged",
            "select * from raw where type = 'commit' and date >= ? and (title like 'Spec%' or title like '%OpenAPI%' or title like 'API%' "
            f"or title like 'REST%') {like} order by date desc limit 20", [since] + extra,
            lambda r: f"{r['date'][:10]}  [{json.loads(r['meta'])['repo'].split('/')[1]}] {r['title'][:110]}")
    n = con.execute("select count(*) from raw where type = 'commit' and date >= ?", (since,)).fetchone()[0]
    print(f"Commits merged upstream in the period: {n}")
    briefs = sorted((root / KB / "briefings" / "weekly").glob("*.md"))
    if briefs:
        print(f"Latest written briefing: {briefs[-1].relative_to(root)}")
    return 0


def cmd_upcoming(root: Path, args) -> int:
    con = open_db(root)
    start = today().isoformat()
    end = (today() + dt.timedelta(days=args.days)).isoformat()
    rows = con.execute("select * from raw where type = 'event' and date >= ? and date <= ? order by date", (start, end + "T99")).fetchall()
    if not rows:
        print("no upcoming events synced (the calendar is collected in the weekly sync)")
        return 0
    print(f"Community meetings in the next {args.days} days (times in UTC):\n")
    for r in rows:
        meta = json.loads(r["meta"])
        print(f"{r['date'][:16].replace('T', ' ')}  {r['title']}")
        if meta.get("group"):
            last = con.execute("select * from raw where type = 'meeting-notes' and json_extract(meta, '$.group') = ? "
                               "order by date desc limit 1", (meta["group"],)).fetchone()
            print(f"    group: groups/{meta['group']}.md" + (f"   last notes: {last['date'][:10]} [{last['id']}]" if last else ""))
        for key in ("notes_doc", "join"):
            if meta.get(key):
                print(f"    {key}: {meta[key]}")
    return 0


def cmd_opportunities(root: Path, args) -> int:
    path = root / KB / "opportunities.md"
    if not path.exists():
        print("kb/opportunities.md has not been written yet")
        return 1
    text = FRONTMATTER.sub("", path.read_text(encoding="utf-8"))
    blocks = re.split(r"\n(?=### )", text)
    wanted = [w.lower() for w in (args.area, args.level) if w]
    if not wanted:
        print(text.strip())
        return 0
    print(blocks[0].strip().split("\n")[0] + "\n")
    shown = [b for b in blocks[1:] if all(w in b.lower() for w in wanted)]
    print("\n\n".join(b.strip() for b in shown) or f"nothing matches {' + '.join(wanted)}; run `kb opportunities` for the full list")
    return 0


# ---------------------------------------------------------------- maintainer and PMC commands

BINDING_NOTE = ("Binding = PMC member on the vote date, per the ASF roster. 'unverified' = the sender's name is not mapped to "
                "a GitHub login yet, so only their own declaration is known. The dev@ thread is the authority.")


def ts(value: str) -> dt.datetime:
    return dt.datetime.strptime(value[:19], "%Y-%m-%dT%H:%M:%S").replace(tzinfo=dt.timezone.utc)


def days_since(value: str | None) -> int | None:
    return (dt.datetime.now(dt.timezone.utc) - ts(value)).days if value else None


def until(value: str) -> str:
    hours = (ts(value) - dt.datetime.now(dt.timezone.utc)).total_seconds() / 3600
    if hours >= 0:
        return f"closes in {hours:.0f}h" if hours < 48 else f"closes in {hours / 24:.0f}d"
    return f"closed {-hours:.0f}h ago" if hours > -48 else f"closed {-hours / 24:.0f}d ago"


def load_votes(root: Path) -> list[dict]:
    return list(read_jsonl(root / KB / "index" / "votes.jsonl"))


def tally_line(t: dict) -> str:
    def part(label, d):
        return f"{label} +1 {d['+1']}, 0 {d['0']}, -1 {d['-1']}"
    text = part("binding", t["binding"]) + "  |  " + part("non-binding", t["non-binding"])
    if any(t["unverified"].values()):
        text += "  |  " + part("unverified", t["unverified"])
    return text


def print_vote(v: dict, verbose: bool) -> None:
    print(f"{v['subject']}  [{v['id']}]")
    print(f"  opened {v['opened'][:10]} by {who(v['opener'])}; {v['messages']} messages; {v['url']}")
    res = v.get("result")
    if res:
        print(f"  result: {res['status']} on {res['date'][:10]} by {who(res['by'])}  [{res['source']}]")
    elif v.get("superseded_by"):
        print(f"  no result posted; superseded by a later release candidate [{v['superseded_by']}]")
    else:
        print(f"  no result posted; deadline {v['deadline'][:16].replace('T', ' ')} UTC ({until(v['deadline'])})")
        if v["kind"] == "release-vote":
            b = v["tally"]["binding"]
            print(f"  release votes need at least 3 binding +1 and more +1 than -1: has {b['+1']} binding +1, {b['-1']} binding -1")
    print(f"  {tally_line(v['tally'])}")
    if v.get("check"):
        print(f"  check against the result email: {v['check']}")
    for value in ("-1", "0"):
        against = [x for x in v["votes"] if x["value"] == value]
        if against:
            print(f"  {value} votes: " + ", ".join(f"{who(x['who'])} ({x['status']}) [{x['source']}]" for x in against))
    unverified = [x for x in v["votes"] if x["status"] == "unverified"]
    if unverified:
        print("  unverified voters: " + ", ".join(f"{who(x['who'])} ({x['value']}, declared {x['declared'] or 'nothing'})"
                                                  for x in unverified))
    if verbose:
        for x in v["votes"]:
            note = f", declared {x['declared']}" if x["declared"] and x["declared"] != x["status"] else ""
            print(f"    {x['date'][:10]}  {x['value']:>2}  {who(x['who'])}  {x['status']}{note}  [{x['source']}]")
    print()


def cmd_votes(root: Path, args) -> int:
    rows = load_votes(root)
    if not rows:
        print("kb: no vote index yet (kb/index/votes.jsonl is built by the sync)")
        return 1
    since = since_date(args.since, 30)
    shown = [v for v in rows if v["opened"][:10] >= since]
    if args.open:
        shown = [v for v in shown if not v.get("result")]
    if args.match:
        words = [w.lower() for w in args.match]
        shown = [v for v in rows if all(w in v["subject"].lower() for w in words)] if not args.since else [
            v for v in shown if all(w in v["subject"].lower() for w in words)]
    if args.kind:
        shown = [v for v in shown if v["kind"] == ("release-vote" if args.kind == "release" else "vote")]
    shown = shown[: args.limit]
    if not shown:
        print(f"no votes match (opened since {since}); try --since 6m or kb votes --match WORDS")
        return 0
    print(f"{len(shown)} vote(s)" + (" without a result" if args.open else "") + "\n")
    for v in shown:
        print_vote(v, args.verbose or len(shown) == 1)
    print(BINDING_NOTE)
    return 0


def open_prs(con, repo: str | None, path: str | None) -> list[dict]:
    sql = "select * from raw where type = 'pr' and json_extract(meta, '$.state') = 'open'"
    params: list = []
    if repo:
        sql += " and json_extract(meta, '$.repo') like ?"
        params.append(f"%{repo}")
    if path:
        cond, p = match_paths(con, path)
        sql += f" and id in (select id from files where {cond})"
        params += p
    out = []
    for r in con.execute(sql, params).fetchall():
        meta = json.loads(r["meta"])
        author = (json.loads(r["people"] or "[]") or [""])[0]
        out.append({"id": r["id"], "title": r["title"], "url": r["url"], "created": r["date"], "author": author, **meta})
    return out


def committers(con) -> set[str]:
    return {p for r in con.execute("select people from raw where type = 'roster'") for p in json.loads(r[0] or "[]")}


def pr_state(pr: dict, team: set[str] = frozenset()) -> str:
    """Whose turn it is on an open pull request, from reviews and the time of the last commit."""
    reviews = [x for x in pr.get("reviews") or [] if x.get("by") != pr["author"]]
    if not reviews:
        return "no review yet"
    last_review = max(x["at"] for x in reviews)
    pushed = pr.get("last_commit")
    latest = {}
    for x in sorted(reviews, key=lambda x: x["at"]):
        if x["state"] in ("APPROVED", "CHANGES_REQUESTED"):
            latest[x["by"]] = x["state"]
    if "APPROVED" in latest.values() and "CHANGES_REQUESTED" not in latest.values():
        if any(state == "APPROVED" and by in team for by, state in latest.items()):
            return "approved by a committer, not merged"
        return "approved by others, needs a committer" if team else "approved, not merged"
    if pushed and pushed > last_review:
        return "updated since the last review"
    return "waiting on the author" if pushed else "reviewed (push time not collected yet)"


def median(values: list[float]) -> float | None:
    values = sorted(values)
    if not values:
        return None
    mid = len(values) // 2
    return values[mid] if len(values) % 2 else (values[mid - 1] + values[mid]) / 2


def cmd_review_queue(root: Path, args) -> int:
    con = open_db(root)
    prs = [p for p in open_prs(con, args.repo, args.path) if args.drafts or not p.get("draft")]
    if not prs:
        print("no open pull requests match")
        return 0
    team = committers(con)
    for p in prs:
        p["queue"] = pr_state(p, team)
        anchor = p.get("last_commit") or p["created"]
        if p["queue"] != "no review yet" and p["queue"] != "updated since the last review":
            anchor = max(x["at"] for x in p.get("reviews") or [{"at": anchor}])
        p["waiting"] = days_since(max(anchor, p["created"])) or 0
    scope = " ".join(x for x in (args.repo, args.path) if x) or "all collected repositories"
    print(f"Open pull requests in {scope}: {len(prs)}" + ("" if args.drafts else " (drafts left out; --drafts to include)"))
    if not any("association" in p for p in prs):
        print("note: author association, requested reviewers and commit times are not collected yet for these pull requests")
    print()
    first_time = [p for p in prs if p.get("association") in ("FIRST_TIME_CONTRIBUTOR", "FIRST_TIMER") and p["queue"] == "no review yet"]
    groups = [("First-time contributors with no review", first_time)]
    for name in ("no review yet", "updated since the last review", "approved by a committer, not merged",
                 "approved by others, needs a committer", "waiting on the author", "reviewed (push time not collected yet)"):
        groups.append((name[0].upper() + name[1:], [p for p in prs if p["queue"] == name and p not in first_time]))
    for title, items in groups:
        if not items:
            continue
        stale = [p for p in items if p["waiting"] >= args.stale]
        print(f"{title}: {len(items)} ({len(stale)} waiting {args.stale}+ days)")
        for p in sorted(stale, key=lambda p: -p["waiting"])[: args.limit]:
            extra = []
            if p.get("requested"):
                extra.append("review requested from " + ", ".join(who(x) for x in p["requested"]))
            if p.get("comments"):
                extra.append(f"{p['comments']} comments")
            if p.get("labels"):
                extra.append(", ".join(p["labels"][:3]))
            print(f"  {p['waiting']:>4}d  #{p['number']} {p['title'][:80]}  by {who(p['author'])}"
                  + (f"  ({'; '.join(extra)})" if extra else ""))
            print(f"         {p['url']}")
        print()
    # Aggregate health: time to first review for pull requests opened in the last 90 days.
    start = since_date("90d", 90)
    sql = "select * from raw where type = 'pr' and date >= ?"
    params = [start]
    if args.repo:
        sql += " and json_extract(meta, '$.repo') like ?"
        params.append(f"%{args.repo}")
    waits, by_area, unreviewed = [], {}, 0
    for r in con.execute(sql, params).fetchall():
        meta = json.loads(r["meta"])
        author = (json.loads(r["people"] or "[]") or [""])[0]
        if meta.get("draft"):
            continue
        firsts = [x["at"] for x in meta.get("reviews") or [] if x.get("by") != author]
        area = (meta.get("files") or ["?"])[0].split("/")[0]
        if args.path and not any(f.startswith(args.path.strip("/")) for f in meta.get("files") or []):
            continue
        if not firsts:
            unreviewed += 1
            continue
        d = (ts(min(firsts)) - ts(r["date"])).total_seconds() / 86400
        waits.append(d)
        by_area.setdefault(area, []).append(d)
    if waits:
        print(f"Time to first review, pull requests opened since {start} (aggregate):")
        print(f"  median {median(waits):.1f} days; {sum(w <= 7 for w in waits) * 100 // len(waits)}% within 7 days; "
              f"{unreviewed} not reviewed yet")
        areas = sorted(by_area.items(), key=lambda kv: -len(kv[1]))[:8]
        print("  by top-level directory: " + ", ".join(f"{a} {median(v):.1f}d (n={len(v)})" for a, v in areas))
        print("  (counts formal reviews only; replies in comments are not counted)")
    return 0


def version_re(version: str) -> re.Pattern:
    return re.compile(r"(?<![\d.])v?" + re.escape(version.lstrip("v")) + r"(?![\d])", re.I)


def cmd_release(root: Path, args) -> int:
    con = open_db(root)
    pat = version_re(args.version)
    repo = (args.repo or "").lower()
    found = False
    for n in con.execute("select * from nodes where type = 'release' order by id").fetchall():
        meta = json.loads(n["meta"])
        if str(meta.get("version")) == args.version.lstrip("v") and repo in n["id"].lower():
            found = True
            show_node(root, con, n, 2500)
            print()
    votes = [v for v in load_votes(root) if v["kind"] == "release-vote" and pat.search(v["subject"])
             and repo in v["subject"].lower().replace(" ", "-")]
    if votes:
        found = True
        print("Release votes (newest first):\n")
        for v in votes:
            print_vote(v, False)
    managers = sorted({v["opener"] for v in votes if v["opener"]})
    if managers:
        print("Release manager (opened the vote): " + ", ".join(who(m) for m in managers) + "\n")
    team = committers(con)
    rows = con.execute("select * from raw where type = 'pr' and json_extract(meta, '$.milestone') like ?",
                       (f"%{args.version.lstrip('v')}%",)).fetchall()
    rows = [r for r in rows if pat.search(json.loads(r["meta"]).get("milestone") or "")]
    if rows:
        found = True
        open_ = [r for r in rows if json.loads(r["meta"])["state"] == "open"]
        milestones = sorted({json.loads(r["meta"])["milestone"] for r in rows})
        print(f"Milestone {', '.join(milestones)}: {len(rows)} pull requests, {len(open_)} open")
        for r in sorted(open_, key=lambda r: r["date"])[: args.limit]:
            print(f"  open  {r['url']}  {r['title'][:80]}  ({pr_state({**json.loads(r['meta']), 'author': (json.loads(r['people'] or '[]') or [''])[0], 'created': r['date']}, team)})")
        print()
    planning = con.execute("select * from raw where type = 'email' and json_extract(meta, '$.kind') in ('release-planning', 'discuss') "
                           "and json_extract(meta, '$.reply') = 0 order by date desc").fetchall()
    near = re.compile(r"(iceberg|release|rust|go|cpp|c\+\+)\W[^\n]{0,30}?" + pat.pattern, re.I)
    planning = [r for r in planning if near.search(r["title"])][:10]
    if planning:
        found = True
        print("Release discussions on dev@:")
        for r in planning:
            n = con.execute("select count(*) from raw where type = 'email' and json_extract(meta, '$.thread') = ?",
                            (json.loads(r["meta"])["thread"],)).fetchone()[0]
            print(f"  {r['date'][:10]}  {r['title'][:90]}  ({n} messages)  [{r['id']}]")
    if not found:
        print(f"nothing found for {args.version}; release pages: kb search --type release {args.version}")
        return 1
    return 0


def quarter_bounds(text: str | None) -> tuple[str, str, str]:
    if text:
        m = re.fullmatch(r"(\d{4})\s*-?\s*Q([1-4])", text.strip(), re.I)
        if not m:
            raise SystemExit("kb: --quarter takes a value such as 2026Q4")
        y, q = int(m.group(1)), int(m.group(2))
        start = dt.date(y, 3 * q - 2, 1)
        end = dt.date(y + (q == 4), 1 if q == 4 else 3 * q + 1, 1)
        return start.isoformat(), end.isoformat(), f"{y} Q{q}"
    end = today() + dt.timedelta(days=1)
    start = end - dt.timedelta(days=91)
    return start.isoformat(), end.isoformat(), f"the last three months ({start} to {today()})"


def cmd_board_report(root: Path, args) -> int:
    con = open_db(root)
    start, end, label = quarter_bounds(args.quarter)
    span = (dt.date.fromisoformat(end) - dt.date.fromisoformat(start)).days
    pstart = (dt.date.fromisoformat(start) - dt.timedelta(days=span)).isoformat()

    def count(sql, params):
        return con.execute(sql, params).fetchone()[0]

    def both(sql, extra=()):
        return count(sql, (start, end, *extra)), count(sql, (pstart, start, *extra))

    def change(now, before):
        return f"{now} (previous period {before}" + (f", {(now - before) * 100 // before:+d}%)" if before else ")")

    print(f"# Apache Iceberg board report draft: {label}\n")
    print("Draft generated from public sources by the Iceberg Context skill. Every number is computed from the archives named "
          "next to it; the PMC reviews, corrects and completes this before submitting it.\n")
    print("## Description\n")
    print("Apache Iceberg is a high-performance format for huge analytic tables.\n")
    print("## Project Status\n")
    print("- Current project status: to be written by the PMC.")
    print("- Issues for the board: to be written by the PMC (none known from public sources).\n")
    print("## Membership Data\n")
    roster = con.execute("select * from raw where type = 'roster'").fetchall()
    pmc = [r for r in roster if json.loads(r["meta"]).get("role") == "pmc"]
    print(f"- {len(roster)} committers, {len(pmc)} of them on the PMC (ASF roster as last synced; source: whimsy committee-info)")
    joined = sorted((json.loads(r["meta"]).get("pmc_since") or "", r["title"].split(":")[0]) for r in pmc)
    new = [j for j in joined if start <= j[0] < end]
    print("- New PMC members in the period: " + (", ".join(f"{n} ({d})" for d, n in new) or "none"))
    if joined:
        print(f"- Last PMC addition: {joined[-1][1]} on {joined[-1][0]}")
    ann = con.execute("select * from raw where type = 'email' and json_extract(meta, '$.kind') = 'roster' "
                      "and json_extract(meta, '$.reply') = 0 and date >= ? and date < ? order by date", (start, end)).fetchall()
    print("- Committer and PMC announcements on dev@ in the period: " + (
        "; ".join(f"{r['date'][:10]} {r['title'][:80]} [{r['id']}]" for r in ann) or "none"))
    print("\n## Project Activity\n")
    rel = con.execute("select * from nodes where type = 'release' order by id").fetchall()
    rel = sorted((json.loads(n["meta"]).get("date") or "", n["title"], n["id"]) for n in rel)
    rel = [x for x in rel if start <= str(x[0]) < end]
    print(f"Releases ({len(rel)}, from [ANNOUNCE] emails):")
    for d, title, nid in rel:
        print(f"- {d}  {title}  [{nid}]")
    passed = [v for v in load_votes(root) if v["kind"] == "vote" and v.get("result") and start <= v["result"]["date"][:10] < end]
    print(f"\nNon-release votes concluded ({len(passed)}):")
    for v in sorted(passed, key=lambda v: v["result"]["date"]):
        print(f"- {v['result']['date'][:10]}  {v['subject'][:90]}: {v['result']['status']}  [{v['result']['source']}]")
    meets = con.execute("select json_extract(meta, '$.group') g, count(*) n from raw where type = 'meeting-notes' and date >= ? "
                        "and date < ? group by g order by n desc", (start, end)).fetchall()
    print(f"\nCommunity syncs with published notes: {sum(m['n'] for m in meets)} "
          f"({', '.join(f'{m[0]} {m[1]}' for m in meets) or 'none synced'})")
    print("\n## Community Health\n")
    mails = both("select count(*) from raw where type = 'email' and date >= ? and date < ?")
    threads = both("select count(*) from raw where type = 'email' and json_extract(meta, '$.reply') = 0 and date >= ? and date < ?")
    senders = both("select count(distinct p.person) from people p join raw r on r.id = p.id where r.type = 'email' "
                   "and r.date >= ? and r.date < ?")
    print(f"- dev@ messages: {change(*mails)}; threads started: {change(*threads)}; distinct senders: {change(*senders)} "
          "(source: lists.apache.org)")
    opened = both("select count(*) from raw where type = 'pr' and date >= ? and date < ?")
    merged = both("select count(*) from raw where type = 'pr' and json_extract(meta, '$.merged_at') >= ? "
                  "and json_extract(meta, '$.merged_at') < ?")
    authors = both("select count(distinct p.person) from people p join raw r on r.id = p.id where r.type = 'pr' "
                   "and r.date >= ? and r.date < ?")
    issues = both("select count(*) from raw where type = 'issue' and date >= ? and date < ?")
    newest_issue = con.execute("select max(json_extract(meta, '$.updated_at')) from raw where type = 'issue'").fetchone()[0] or ""
    issue_text = change(*issues) if newest_issue >= end else f"not fully collected yet (issues synced up to {newest_issue[:10] or 'none'})"
    print(f"- Pull requests opened: {change(*opened)}; merged: {change(*merged)}; distinct authors: {change(*authors)}; "
          f"issues opened: {issue_text} (source: GitHub, repositories collected in full: "
          + ", ".join(sorted({json.loads(r['meta']).get('repo', '') for r in con.execute(
              "select meta from raw where type = 'pr' limit 2000").fetchall()} - {''})) + ")")
    for repo in sorted({r[0] for r in con.execute("select distinct json_extract(meta, '$.repo') from raw where type = 'commit'")
                        if r[0]}):
        c = both("select count(*) from raw where type = 'commit' and date >= ? and date < ? and json_extract(meta, '$.repo') = ?",
                 (repo,))
        a = both("select count(distinct p.person) from people p join raw r on r.id = p.id where r.type = 'commit' "
                 "and r.date >= ? and r.date < ? and json_extract(r.meta, '$.repo') = ?", (repo,))
        print(f"- {repo}: commits {change(*c)}; distinct commit authors {change(*a)} (source: git history)")
    print("\nNumbers are counted from the collected archives; check `kb status` for how complete each source is.")
    return 0


def extractions(root: Path, kind: str):
    base = root / "data" / "extract" / kind
    if base.is_dir():
        for path in sorted(base.rglob("*.json")):
            try:
                yield json.loads(path.read_text(encoding="utf-8"))
            except json.JSONDecodeError:
                continue


def matches(text: str, words: list[str]) -> bool:
    low = text.lower()
    return all(w in low for w in words)


def thread_dates(con) -> dict[str, str]:
    return {r[0]: r[1] for r in con.execute("select json_extract(meta, '$.thread'), max(date) from raw where type = 'email' "
                                            "group by json_extract(meta, '$.thread')")}


def cmd_decisions(root: Path, args) -> int:
    con = open_db(root)
    words = [w.lower() for w in args.topic]
    items = []
    for v in load_votes(root):
        res = v.get("result")
        if res and res["status"] in ("passed", "failed") and matches(v["subject"], words):
            items.append((res["date"][:10], "vote", f"{v['subject']}: {res['status']} ({tally_line(v['tally'])})", res["source"]))
    for ex in extractions(root, "meetings"):
        date = ex["id"].rsplit("/", 1)[-1]
        for t in ex.get("topics") or []:
            context = " ".join([t.get("title", ""), " ".join(t.get("initiatives") or [])])
            for d in t.get("decisions") or []:
                if matches(d + " " + context, words):
                    items.append((date, "meeting", f"{t.get('title', '')}: {d}", ex["sources"][0]))
    dates = thread_dates(con)
    for ex in extractions(root, "threads"):
        out = ex.get("outcome") or {}
        if out.get("status") in ("passed", "failed", "consensus") and matches(
                " ".join([ex.get("title", ""), ex.get("summary", ""), " ".join(ex.get("initiatives") or [])]), words):
            items.append((dates.get(ex["id"].split("/")[1], "")[:10], "thread",
                          f"{ex.get('title', '')}: {out['status']}" + (f". {out['note']}" if out.get("note") else ""),
                          out.get("source") or ex["sources"][0]))
    if not items:
        print(f"no recorded decisions match {' '.join(args.topic)!r}; try fewer words, or kb search")
        return 1
    seen, rows = set(), []
    for item in sorted(items, reverse=True):
        if (item[1], item[2]) not in seen:
            seen.add((item[1], item[2]))
            rows.append(item)
    print(f"Decisions matching {' '.join(args.topic)!r}, newest first:\n")
    for date, kind, text, src in rows[: args.limit]:
        basis = {"vote": "counted from the vote thread", "meeting": "from meeting notes, AI-extracted",
                 "thread": "from the dev@ thread, AI-summarized"}[kind]
        print(f"{date}  [{kind}] {text[:300]}")
        print(f"            {basis}  [{src}]")
    print("\nMeeting decisions are proposals until confirmed on dev@; check the source before relying on one.")
    return 0


def cmd_loose_ends(root: Path, args) -> int:
    con = open_db(root)
    since = since_date(args.since, 60)
    print(f"Loose ends since {since}\n")
    unowned = []
    for ex in extractions(root, "meetings"):
        date = ex["id"].rsplit("/", 1)[-1]
        if date < since:
            continue
        for a in ex.get("action_items") or []:
            if not (a.get("who") or "").strip() or (a.get("who") or "").strip().lower() in ("unassigned", "tbd", "?", "none"):
                unowned.append((date, ex["id"], a["what"]))
    print(f"Action items from meetings with no owner ({len(unowned)}):")
    for date, mid, what in sorted(unowned, reverse=True)[: args.limit]:
        print(f"  {date}  {what[:160]}  [{mid}]")
    dates = thread_dates(con)
    decided = {v["id"].split(":", 1)[1] for v in load_votes(root) if v.get("result")}
    stalled = []
    for ex in extractions(root, "threads"):
        tid = ex["id"].split("/")[1]
        last = dates.get(tid, "")
        if (ex.get("outcome") or {}).get("status") in ("open", "no-conclusion") and last[:10] >= since and tid not in decided:
            stalled.append((last[:10], ex.get("title", ""), ex["id"]))
    print(f"\nDiscussions with no conclusion ({len(stalled)}, last message date shown):")
    for last, title, tid in sorted(stalled, reverse=True)[: args.limit]:
        print(f"  {last}  {title[:110]}  [{tid}]")
    rows = con.execute(
        "select r.*, count(*) over (partition by json_extract(r.meta, '$.thread')) n from raw r where r.type = 'email' "
        "and json_extract(r.meta, '$.thread') in (select json_extract(meta, '$.thread') from raw where type = 'email' "
        "and json_extract(meta, '$.reply') = 0 and date >= ? and json_extract(meta, '$.kind') in ('discuss', 'other'))",
        (since,)).fetchall()
    lonely = [r for r in rows if r["n"] == 1 and not re.match(r"\s*(\[(announce|result|fyi)|(re|fwd?|aw)\s*:)", r["title"], re.I)]
    print(f"\ndev@ threads with no reply ({len(lonely)}):")
    for r in sorted(lonely, key=lambda r: r["date"], reverse=True)[: args.limit]:
        print(f"  {r['date'][:10]}  {r['title'][:100]}  by {people_of(r)}  [{r['id']}]")
    print("\nThreads are matched by their reply headers, so a reply posted as a new thread can make one look unanswered.")
    return 0


def main(argv: list[str] | None = None) -> int:
    parser = argparse.ArgumentParser(prog="kb", description="Query the Iceberg Context knowledge base.")
    sub = parser.add_subparsers(dest="command", required=True)
    sub.add_parser("status", help="how fresh each source is and what the knowledge base holds").set_defaults(fn=cmd_status)
    sub.add_parser("update", help="fetch the latest knowledge base now").set_defaults(fn=cmd_update)

    p = sub.add_parser("search", help="full-text search over pages and source records")
    p.add_argument("query", nargs="+")
    p.add_argument("--type", help="one kind: person, group, initiative, module, meeting, thread, email, pr, issue, comment, "
                                  "meeting-notes, transcript, spec-section, doc")
    p.add_argument("--since", help="only records dated after this: YYYY-MM-DD or a span such as 30d, 6m")
    p.add_argument("--limit", type=int, default=10)
    p.set_defaults(fn=cmd_search)

    p = sub.add_parser("source", help="show the text and link behind an id")
    p.add_argument("id")
    p.add_argument("--grep", help="show only the passages containing this text")
    p.add_argument("--chars", type=int, default=3000)
    p.set_defaults(fn=cmd_source)

    p = sub.add_parser("why", help="the history behind a file or directory: commits, pull requests, discussions")
    p.add_argument("path", help="path relative to the Iceberg repository root (a suffix such as SnapshotProducer.java also works)")
    p.add_argument("--limit", type=int, default=12)
    p.add_argument("--symbol", help="a function or class name; needs --checkout pointing at a clone with history")
    p.add_argument("--checkout", help="path to a local Iceberg clone, for --symbol")
    p.set_defaults(fn=cmd_why)

    p = sub.add_parser("context", help="what to know before editing these paths")
    p.add_argument("paths", nargs="+")
    p.add_argument("--since", help="window for activity counts (default 1y)")
    p.set_defaults(fn=cmd_context)

    for name, kind, text in (("initiative", "initiative", "status and timeline of an initiative"),
                             ("person", "person", "public roles and project activity of a contributor"),
                             ("group", "group", "a working group: cadence, notes, recent meetings"),
                             ("show", None, "print any page by id or name")):
        p = sub.add_parser(name, help=text)
        p.add_argument("name", nargs="+")
        p.add_argument("--chars", type=int, default=6000)
        p.set_defaults(fn=cmd_show(kind))

    p = sub.add_parser("who-to-ask", help="who works on a path or topic, and which group handles it")
    p.add_argument("topic", nargs="+")
    p.add_argument("--since", help="activity window (default 1y)")
    p.set_defaults(fn=cmd_who)

    p = sub.add_parser("whats-new", help="votes, discussions, meetings and spec changes since a date")
    p.add_argument("--since", help="YYYY-MM-DD or a span such as 7d, 2w (default 7d)")
    p.add_argument("--area", help="keep only items whose title contains this text")
    p.set_defaults(fn=cmd_whats_new)

    p = sub.add_parser("upcoming", help="community meetings in the coming days")
    p.add_argument("--days", type=int, default=14)
    p.set_defaults(fn=cmd_upcoming)

    p = sub.add_parser("opportunities", help="ranked places to contribute")
    p.add_argument("--area", help="filter by text, e.g. python, spark, rest")
    p.add_argument("--level", help="filter by level: starter, intermediate, advanced")
    p.set_defaults(fn=cmd_opportunities)

    p = sub.add_parser("votes", help="dev@ votes with binding and non-binding tallies (maintainers and PMC)")
    p.add_argument("--open", action="store_true", help="only votes with no result posted")
    p.add_argument("--since", help="opened after: YYYY-MM-DD or a span such as 30d, 6m (default 30d)")
    p.add_argument("--match", nargs="+", help="words that must appear in the subject (searches all years unless --since)")
    p.add_argument("--kind", choices=("release", "other"), help="release votes or other votes")
    p.add_argument("--verbose", action="store_true", help="list every voter")
    p.add_argument("--limit", type=int, default=15)
    p.set_defaults(fn=cmd_votes)

    p = sub.add_parser("review-queue", help="open pull requests by whose turn it is, and time to first review")
    p.add_argument("--path", help="only pull requests touching this path, e.g. flink/ or core/src/main")
    p.add_argument("--repo", help="iceberg or iceberg-python (default: all collected)")
    p.add_argument("--stale", type=int, default=14, help="list items waiting at least this many days (default 14)")
    p.add_argument("--drafts", action="store_true", help="include draft pull requests")
    p.add_argument("--limit", type=int, default=10)
    p.set_defaults(fn=cmd_review_queue)

    p = sub.add_parser("release", help="a release: votes, release manager, milestone pull requests, dev@ discussion")
    p.add_argument("version", help="e.g. 1.10.0 or 0.10.0")
    p.add_argument("--repo", help="narrow to a project, e.g. python, rust, go")
    p.add_argument("--limit", type=int, default=20)
    p.set_defaults(fn=cmd_release)

    p = sub.add_parser("board-report", help="draft of the quarterly ASF board report, numbers from public sources")
    p.add_argument("--quarter", help="e.g. 2026Q4 (default: the last three months)")
    p.set_defaults(fn=cmd_board_report)

    p = sub.add_parser("decisions", help="past decisions and vote results on a topic, with sources")
    p.add_argument("topic", nargs="+")
    p.add_argument("--limit", type=int, default=15)
    p.set_defaults(fn=cmd_decisions)

    p = sub.add_parser("loose-ends", help="unowned action items, discussions with no conclusion, unanswered dev@ threads")
    p.add_argument("--since", help="YYYY-MM-DD or a span such as 30d (default 60d)")
    p.add_argument("--limit", type=int, default=12)
    p.set_defaults(fn=cmd_loose_ends)

    args = parser.parse_args(argv)
    try:
        return args.fn(repo_root(), args)
    except BrokenPipeError:
        return 0


if __name__ == "__main__":
    raise SystemExit(main())
